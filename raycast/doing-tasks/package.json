{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "doing-tasks",
  "title": "Doing Tasks",
  "description": "Keep Obsidian kanban tasks visible and close them from the menu bar.",
  "icon": "extension-icon.png",
  "author": "yeshwanth",
  "license": "MIT",
  "commands": [
    {
      "name": "doing-tasks",
      "title": "Doing Tasks",
      "description": "Show and close tasks in the Doing column",
      "mode": "menu-bar",
      "interval": "1m"
    }
  ],
  "dependencies": {
    "@raycast/api": "1.104.24"
  },
  "devDependencies": {
    "@raycast/eslint-config": "2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "9.22.0",
    "prettier": "3.5.3",
    "typescript": "5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix"
  }
}
